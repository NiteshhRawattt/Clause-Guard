# ClauseGuard Frontend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env itself.

# ── API Backend URL ───────────────────────────────────────────────────────────
# During local development, leave this unset — the Vite dev proxy forwards /api/* to :3001
# For production deployments, set this to your deployed backend URL:
# VITE_API_URL=https://your-api-server.com
