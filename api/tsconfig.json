{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "../api/**/*",
    "../server/src/**/*"
  ],
  "exclude": ["../node_modules", "../server/node_modules", "../dist"]
}
